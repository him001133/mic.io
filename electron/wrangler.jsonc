{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voicestudio",
  "compatibility_date": "2026-10-31",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BACKEND_ORIGIN": ""
  },
  "observability": {
    "http": {
      "request_fields": [
        "cf-ray",
        "user-agent",
        "host"
      ]
    }
  }
}
